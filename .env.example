# Persistence path. Container default is /data/users.json.
IDENTITY_DATA_PATH=data/users.json

# PBKDF2-HMAC-SHA256 work factor. Allowed: 100000-2000000.
PBKDF2_ITERATIONS=210000

# Opaque session lifetime in minutes. Allowed: 5-1440.
SESSION_TTL_MINUTES=60

# Standard ASP.NET Core binding example.
ASPNETCORE_URLS=http://0.0.0.0:8080
